<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="page unresolved-page">
  <header class="page-head unresolved-head">
    <h1 class="page-title"><%= title %></h1>
    <p class="page-sub"><%= t('unresolved_intro') %></p>
    <form class="unresolved-search" method="get" action="/n" role="search">
      <label class="sr-only" for="unresolvedSearch"><%= t('unresolved_search') %></label>
      <input id="unresolvedSearch" type="search" name="q" value="<%= query %>" placeholder="<%= t('unresolved_search') %>" autocomplete="off">
      <button class="btn btn-primary btn-sm" type="submit"><%= t('search') %></button>
      <% if (query) { %><a class="btn btn-ghost btn-sm" href="/n"><%= t('reset') %></a><% } %>
    </form>
  </header>

  <section class="unresolved-summary" aria-label="Rezumat">
    <div class="unresolved-summary-card">
      <strong><%= total %></strong>
      <span><%= t('unresolved_title') %></span>
    </div>
    <% categoryTotals.forEach(function(category) { %>
      <div class="unresolved-summary-card">
        <strong><%= category.count %></strong>
        <span><%= category.label %></span>
      </div>
    <% }) %>
  </section>

  <% if (gradeGroups.length === 0) { %>
    <div class="unresolved-empty card panel">
      <% if (query) { %>
        <h2>Niciun ID nu a fost găsit</h2>
        <p>Nu există probleme incomplete cu ID-ul care conține „<%= query %>”. Încearcă alt număr.</p>
      <% } else { %>
        <h2>Totul este complet</h2>
        <p>Toate problemele din arhivă au enunț și soluție.</p>
      <% } %>
    </div>
  <% } else { %>
    <% gradeGroups.forEach(function(gradeGroup) { %>
      <section class="unresolved-grade">
        <header class="unresolved-grade-head">
          <div>
            <span class="unresolved-kicker">Clasă</span>
            <h2><%= gradeGroup.label %></h2>
          </div>
          <span class="unresolved-count"><%= gradeGroup.count %> ID-uri</span>
        </header>

        <% gradeGroup.difficulties.forEach(function(difficultyGroup) { %>
          <section class="unresolved-difficulty-group">
            <header class="unresolved-difficulty-head">
              <h3>Dificultate: <%= difficultyGroup.label %></h3>
              <span><%= difficultyGroup.count %></span>
            </header>
            <% difficultyGroup.categories.forEach(function(category) { %>
              <section class="unresolved-category">
                <header class="unresolved-category-head">
                  <h4><%= category.label %></h4>
                  <span><%= category.count %></span>
                </header>
                <% if (category.count === 0) { %>
                  <p class="unresolved-none">Nicio problemă în această categorie.</p>
                <% } else { %>
                  <div class="unresolved-ids">
                    <% category.problems.forEach(function(problem) { %>
                      <a href="/p/<%= problem.id %>" aria-label="Deschide problema <%= problem.id %>">#<%= problem.id %></a>
                    <% }) %>
                  </div>
                <% } %>
              </section>
            <% }) %>
          </section>
        <% }) %>
      </section>
    <% }) %>
  <% } %>
</main>

<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
