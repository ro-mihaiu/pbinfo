<header class="site-header">
  <div class="nav-inner">
    <button class="hamburger" id="menuBtn" aria-label="<%= t('menu') %>" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <a class="brand" href="/">
      <img class="brand-logo" src="/logo.png" alt="Logo Arhiva PBInfo">
      <span class="brand-text">
        <span class="brand-name"><%= t('brand') %></span>
        <span class="brand-sub"><%= t('brand_subtitle') %></span>
      </span>
    </a>

    <nav class="nav-links">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>"><%= t('nav_home') %></a>
      <a href="/p" class="<%= path.startsWith('/p') || path.startsWith('/archive') ? 'active' : '' %>"><%= t('nav_problems') %></a>
      <a href="/h" class="<%= path.startsWith('/h') || path.startsWith('/tema') ? 'active' : '' %>"><%= t('nav_homework') %></a>
    </nav>

    <div class="nav-actions">
      <button class="theme-toggle" id="themeToggle" aria-label="<%= t('theme') %>">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <div class="social-links">
        <a href="<%= social.discord %>" target="_blank" rel="noopener" class="social-btn discord" aria-label="Discord">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286z"></path><path d="M8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"></path></svg>
        </a>
        <a href="<%= social.instagram %>" target="_blank" rel="noopener" class="social-btn instagram" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
    </div>
  </div>
</header>

<div class="dropdown-overlay" id="dropdownOverlay"></div>
<nav class="dropdown-menu" id="dropdownMenu" aria-hidden="true">
  <div class="dropdown-head">
    <span class="brand-name"><%= t('brand') %></span>
    <button class="dropdown-close" id="dropdownClose" aria-label="<%= t('close') %>">&times;</button>
  </div>
  <a href="/" class="<%= path === '/' ? 'active' : '' %>"><%= t('nav_home') %></a>
  <a href="/p" class="<%= path.startsWith('/p') || path.startsWith('/archive') ? 'active' : '' %>"><%= t('nav_problems') %></a>
  <a href="/h" class="<%= path.startsWith('/h') || path.startsWith('/tema') ? 'active' : '' %>"><%= t('nav_homework') %></a>
  <div class="dropdown-divider"></div>
  <span class="dropdown-label"><%= t('footer_social') %></span>
  <a href="<%= social.discord %>" target="_blank" rel="noopener">Discord</a>
  <a href="<%= social.instagram %>" target="_blank" rel="noopener">Instagram</a>
  <div class="dropdown-divider"></div>
  <a href="/privacy"><%= t('legal_privacy') %></a>
  <a href="/terms"><%= t('legal_terms') %></a>
  <a href="/cookies"><%= t('legal_cookies') %></a>
</nav>
