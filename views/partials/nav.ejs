<header class="site-header">
  <div class="nav-inner">
    <button class="hamburger" id="menuBtn" aria-label="<%= t('menu') %>" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <a class="brand" href="/">
      <span class="brand-logo">&#128218;</span>
      <span class="brand-text">
        <span class="brand-name"><%= t('brand') %></span>
        <span class="brand-sub"><%= t('brand_subtitle') %></span>
      </span>
    </a>

    <nav class="nav-links">
      <a href="/" class="<%= path === '/' ? 'active' : '' %>"><%= t('nav_home') %></a>
      <a href="/p" class="<%= path.startsWith('/p') || path.startsWith('/archive') ? 'active' : '' %>"><%= t('nav_problems') %></a>
      <a href="/h" class="<%= path.startsWith('/h') || path.startsWith('/tema') ? 'active' : '' %>"><%= t('nav_homework') %></a>
    </nav>

    <div class="nav-actions">
      <button class="theme-toggle" id="themeToggle" aria-label="<%= t('theme') %>">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
      <div class="social-links">
        <a href="<%= social.discord %>" target="_blank" rel="noopener" class="social-btn discord" aria-label="Discord">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.3 4.4A18.5 18.5 0 0 0 15.4 3l-.2.4a17 17 0 0 1 4.8 2.4 14.6 14.6 0 0 0-12.9 0A16.6 16.6 0 0 1 12 3.4L11.8 3a18.5 18.5 0 0 0-4.9 1.4C3.4 9 2.6 13.5 2.9 17.9A18.6 18.6 0 0 0 8.5 21l.6-1a12 12 0 0 1-1.9-.9l.5-.4a13.3 13.3 0 0 0 11.4 0l.5.4a12 12 0 0 1-1.9.9l.6 1a18.6 18.6 0 0 0 5.6-3.1c.4-5-.8-9.4-3.5-13.5zM8.7 15.3c-.9 0-1.7-.9-1.7-1.9s.7-1.9 1.7-1.9 1.7.9 1.7 1.9-.8 1.9-1.7 1.9zm6.6 0c-.9 0-1.7-.9-1.7-1.9s.7-1.9 1.7-1.9 1.7.9 1.7 1.9-.8 1.9-1.7 1.9z"/></svg>
        </a>
        <a href="<%= social.instagram %>" target="_blank" rel="noopener" class="social-btn instagram" aria-label="Instagram">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
        </a>
      </div>
    </div>
  </div>
</header>

<div class="dropdown-overlay" id="dropdownOverlay"></div>
<nav class="dropdown-menu" id="dropdownMenu" aria-hidden="true">
  <div class="dropdown-head">
    <span class="brand-name"><%= t('brand') %></span>
    <button class="dropdown-close" id="dropdownClose" aria-label="<%= t('close') %>">&times;</button>
  </div>
  <a href="/" class="<%= path === '/' ? 'active' : '' %>"><%= t('nav_home') %></a>
  <a href="/p" class="<%= path.startsWith('/p') || path.startsWith('/archive') ? 'active' : '' %>"><%= t('nav_problems') %></a>
  <a href="/h" class="<%= path.startsWith('/h') || path.startsWith('/tema') ? 'active' : '' %>"><%= t('nav_homework') %></a>
  <div class="dropdown-divider"></div>
  <span class="dropdown-label"><%= t('footer_social') %></span>
  <a href="<%= social.discord %>" target="_blank" rel="noopener">Discord</a>
  <a href="<%= social.instagram %>" target="_blank" rel="noopener">Instagram</a>
  <div class="dropdown-divider"></div>
  <a href="/privacy"><%= t('legal_privacy') %></a>
  <a href="/terms"><%= t('legal_terms') %></a>
  <a href="/cookies"><%= t('legal_cookies') %></a>
</nav>
