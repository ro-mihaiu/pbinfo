<%- include('partials/head', { title: 'Raportează o problemă' }) %>
<%- include('partials/nav') %>
<main class="problem-form">
  <section class="card panel">
    <h1 class="panel-title">Raportează o problemă</h1>
    <form method="post" action="/i">
      <div class="form-group">
        <label for="problemId">Problema (ID)</label>
        <input id="problemId" name="problemId" type="number" required>
      </div>
      <div class="form-group description-field">
        <label for="issue">Descrierea problemei</label>
        <textarea id="issue" name="issue" rows="5" required maxlength="5000"></textarea>
      </div>
      <div class="contact-fields">
        <div class="form-group">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" maxlength="254">
        </div>
        <div class="form-group">
          <label for="whatsapp">WhatsApp</label>
          <input id="whatsapp" name="whatsapp" type="text" maxlength="100">
        </div>
      </div>
      <div class="form-group code-field">
        <label for="code">Cod C++</label>
        <textarea id="code" name="code" rows="10" maxlength="20000"></textarea>
      </div>
      <button type="submit" class="btn btn-primary">Trimite</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
