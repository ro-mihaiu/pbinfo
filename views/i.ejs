<%- include('../partials/header', { title: 'Issue' }) %>
<section class="card panel">
  <h1>Raportează o problemă</h1>
  <form method="post" action="/i">
    <label>Problema (ID)<input name="problemId" type="number" required></label>
    <label>Descrierea problemei<textarea name="issue" rows="5" required maxlength="5000"></textarea></label>
    <label>Email<input name="email" type="email" maxlength="254"></label>
    <label>WhatsApp<input name="whatsapp" type="text" maxlength="100"></label>
    <label>Cod C++<textarea name="code" rows="8" maxlength="20000"></textarea></label>
    <button type="submit" class="btn btn-primary">Trimite</button>
  </form>
</section>
<%- include('../partials/footer') %>
