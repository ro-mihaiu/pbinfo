<%- include('partials/head') %>
<%- include('partials/nav') %>

<main class="page">
  <nav class="breadcrumb">
    <a href="/p"><%= t('nav_problems') %></a>
    <span>/</span>
    <span>#<%= problem.id %></span>
  </nav>

  <section class="problem-header card">
    <div class="problem-title-row">
      <div>
        <span class="problem-id-large">#<%= problem.id %></span>
        <h1 class="problem-title"><%= problem.titles.ro %></h1>
        <% if (problem.titles.en) { %>
          <p class="problem-en muted"><%= problem.titles.en %></p>
        <% } %>
      </div>
      <div class="problem-header-actions">
        <span class="diff-badge diff-<%= problem.difficulty %>"><%= difficultyLabel %></span>
      </div>
    </div>
    <div class="problem-meta">
      <% if (gradeLabel) { %>
        <span class="meta-item">
          <strong><%= t('problem_grade') %>:</strong> <%= gradeLabel %>
        </span>
      <% } %>
      <span class="meta-item">
        <strong><%= t('problem_difficulty') %>:</strong> <%= difficultyLabel %>
      </span>
      <div class="meta-tags">
        <% (problem.tags || []).forEach(function(tag) { %>
          <a href="/p?tag=<%= tag %>" class="tag"><%= tag %></a>
        <% }) %>
      </div>
    </div>
    <% if (problem.notes && problem.notes.ro) { %>
      <div class="problem-notes">
        <strong><%= t('problem_notes') %>:</strong> <%= problem.notes.ro %>
      </div>
    <% } %>
    <a class="pbinfo-header-link" href="https://pbinfo.ro/rezolvari/<%= problem.id %>/<%= problem.titles.ro %>" target="_blank" rel="noopener noreferrer">PBInfo</a>
  </section>

  <div class="problem-layout">
    <div class="problem-main">
      <% if (statement && statement.length > 0) { %>
        <section class="card panel">
          <h2 class="panel-title"><%= t('problem_statement') %></h2>
          <% statement.forEach(function(sec) { %>
            <% if (sec.heading) { %>
              <h3 class="stmt-heading"><%= sec.heading %></h3>
            <% } %>
            <% sec.content.split('\n').forEach(function(line) { %>
              <p class="stmt-line"><%= line %></p>
            <% }) %>
          <% }) %>
        </section>
      <% } else { %>
        <section class="card panel empty-panel">
          <p class="muted"><%= t('problem_no_statement') %></p>
        </section>
      <% } %>

      <% if (examples.length > 0) { %>
        <section class="card panel">
          <h2 class="panel-title">Exemple</h2>
          <% examples.forEach(function(example, index) { %>
            <div class="example-block">
              <h3 class="stmt-heading">Exemplul <%= index + 1 %></h3>
              <div class="example-grid">
                <% if (example.date_intrare) { %>
                  <div class="example-field">
                    <div class="example-field-head"><strong>Intrare</strong><button type="button" class="icon-copy-btn copy-btn" data-copy-target="example-input-<%= problem.id %>-<%= index %>" aria-label="Copiază intrarea" title="Copiază intrarea">📋</button></div>
                    <textarea id="example-input-<%= problem.id %>-<%= index %>" class="example-editor" rows="3"><%= example.date_intrare %></textarea>
                  </div>
                <% } %>
                <% if (example.date_iesire) { %>
                  <div class="example-field">
                    <div class="example-field-head"><strong>Ieșire</strong><button type="button" class="icon-copy-btn copy-btn" data-copy-target="example-output-<%= problem.id %>-<%= index %>" aria-label="Copiază ieșirea" title="Copiază ieșirea">📋</button></div>
                    <textarea id="example-output-<%= problem.id %>-<%= index %>" class="example-editor" rows="3"><%= example.date_iesire %></textarea>
                  </div>
                <% } %>
              </div>
              <% if (example.explicatie) { %><p class="stmt-line"><%= example.explicatie %></p><% } %>
            </div>
          <% }) %>
        </section>
      <% } %>

      <% if (hasSolution) { %>
        <section class="card panel">
          <div class="code-head">
            <h2 class="panel-title"><%= t('problem_solutions') %></h2>
            <button class="btn btn-ghost btn-sm copy-btn" data-copy-target="solutionCode"><%= t('problem_copy') %></button>
          </div>
          <pre class="code-block"><code id="solutionCode" class="language-cpp"><%= solution %></code></pre>
        </section>
      <% } else { %>
        <section class="card panel empty-panel">
          <p class="muted"><%= t('problem_no_solution') %></p>
        </section>
      <% } %>
    </div>

    <aside class="problem-side">
      <section class="card panel issue-panel" id="issue-form">
        <h2 class="panel-title">Raportează o problemă</h2>
        <% if (issueStatus === 'sent') { %><p class="form-success">Mesajul a fost trimis. Vei fi contactat după rezolvare.</p><% } %>
        <% if (issueStatus === 'invalid' || issueStatus === 'error') { %><p class="form-error">Completează problema și cel puțin o metodă de contact.</p><% } %>
        <form method="post" action="/p/<%= problem.id %>/issues">
          <input type="hidden" name="problemId" value="<%= problem.id %>">
          <label>Problema<input type="text" value="#<%= problem.id %>" readonly></label>
          <label for="issue">Descrierea problemei<textarea id="issue" name="issue" rows="5" required maxlength="5000" placeholder="Ce trebuie verificat?"></textarea></label>
          <label for="email">Email<input id="email" name="email" type="email" maxlength="254" placeholder="nume@exemplu.ro"></label>
          <label for="whatsapp">WhatsApp username / telefon<input id="whatsapp" name="whatsapp" type="text" maxlength="100" placeholder="@username sau +40..."></label>
          <label for="code">Cod C++<textarea id="code" name="code" rows="8" maxlength="20000" placeholder="Codul tău C++"></textarea></label>
          <button type="submit" class="btn btn-primary">Trimite sesizarea</button>
        </form>
      </section>

      <div class="card panel nav-panel">
<h3 class="panel-title"><%= t('nav_problems') %></h3>
        <div class="prev-next">
          <% if (prev) { %>
            <a href="/p/<%= prev.id %>" class="nav-item prev">
              <span class="nav-dir">&larr; <%= t('problem_prev') %></span>
              <span class="nav-title">#<%= prev.id %> · <%= prev.titles.ro %></span>
            </a>
          <% } else { %>
            <span class="nav-item disabled">&larr; <%= t('problem_prev') %></span>
          <% } %>
          <% if (next) { %>
            <a href="/p/<%= next.id %>" class="nav-item next">
              <span class="nav-dir"><%= t('problem_next') %> &rarr;</span>
              <span class="nav-title">#<%= next.id %> · <%= next.titles.ro %></span>
            </a>
          <% } else { %>
            <span class="nav-item disabled"><%= t('problem_next') %> &rarr;</span>
          <% } %>
        </div>
      </div>
    </aside>
  </div>

</main>


<%- include('partials/footer') %>
<script src="/js/main.js"></script>
</body>
</html>
